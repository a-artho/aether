AETHER_PROJECT_VERSION=2.0.3
AETHER_PRODUCT_BUNDLE_IDENTIFIER=com.anfear.aether
AETHER_DISAMBIGUATOR=${DEVELOPMENT_TEAM}

AD_HOC_CODE_SIGNING_ALLOWED = YES

DEPLOYMENT_LOCATION = YES
DSTROOT = $(SRCROOT)/_build/

// Audit concurrency at module boundaries while retaining Swift 5 language compatibility.
SWIFT_STRICT_CONCURRENCY=complete
