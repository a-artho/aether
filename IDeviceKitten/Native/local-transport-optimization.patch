+                        if fail { assert!(events.iter().all(|n| *n < size.min(MAX_WRITE_TRANSFER) as u64)); }
+                        else { assert_eq!(events.last().copied(), Some(size as u64)); }
+                    } else { assert!(events.is_empty()); }
+                    if !profiled { assert_eq!(metrics.write_polls, 0); assert_eq!(metrics.serialize_seconds, 0.0); }
+                    drop(file);
+                    receiver.await.unwrap();
+                }
+            }
+        }
+    }
+
+}
