+//! Functional AFC -> background jktcp -> real TLS-record -> TCP-socket tests.
+//! Fixed symmetric fixture keys bypass pairing only; both production ciphers,
+//! record MACs, packet boundaries, ACKs, loss repair and AFC status are real.
+use super::*;
+use crate::tcp::packets::{Ipv6Packet, ProtocolNumber, TcpFlags, TcpPacket};
+use std::{collections::BTreeMap, net::Ipv6Addr, time::Duration};
+use tokio::net::{TcpListener, TcpStream};
+
+const HOST: Ipv6Addr = Ipv6Addr::new(0xfd00, 0, 0, 0, 0, 0, 0, 1);
+const PEER: Ipv6Addr = Ipv6Addr::new(0xfd00, 0, 0, 0, 0, 0, 0, 2);
+
+fn keyed(inner: TcpStream, suite: CipherSuite) -> TlsPskStream<TcpStream> {
+    TlsPskStream {
+        inner, keys: KeyBlock::new(vec![1; suite.mac_key_len()], vec![1; suite.mac_key_len()],
+            vec![2; suite.enc_key_len()], vec![2; suite.enc_key_len()], suite),
+        write_seq: 0, read_seq: 0, read_buf: vec![], pending_record: vec![],
+        pending_record_total: 0, write_buf: vec![], write_buf_offset: 0,
+    }
+}
+
+async fn respond(peer: &mut TlsPskStream<TcpStream>, port: u16, ack: u32,
+    sequence: &mut u32, syn: bool, payload: &[u8]) {
+    let options: &[u8] = if syn { &[3, 3, 8, 1, 2, 4, 0x3e, 0x44] } else { &[] }; // MSS 15940
+    let tcp = TcpPacket::create(PEER.into(), HOST.into(), 1234, port, *sequence, ack,
+        TcpFlags { syn, ack: true, psh: !payload.is_empty(), ..Default::default() },
+        65534, options, payload);
+    let packet = Ipv6Packet::create(PEER, HOST, ProtocolNumber::Tcp, 255, &tcp);
+    peer.write_all(&packet).await.unwrap();
+    peer.flush().await.unwrap();
+    *sequence = sequence.wrapping_add(payload.len() as u32 + u32::from(syn));
+}
+
+async fn serve(mut peer: TlsPskStream<TcpStream>, shrinks: bool,
+    completed: tokio::sync::oneshot::Sender<(usize, usize, usize)>) {
+    let mut initial_seq = 0;
+    let mut received: usize = 0;
+    let mut afc = Vec::new();
+    let mut reordered = BTreeMap::<usize, Vec<u8>>::new();
+    let mut sequence = u32::MAX - 100;
+    let mut payload_offset = 0;
+    let mut drops = 0;
+    let mut largest = 0;
+    loop {
+        // Inspect individual authenticated TLS records, rather than combining
+        // reads into an IP byte stream that would hide forbidden coalescing.
+        let (ct, encrypted) = read_record(&mut peer.inner).await.unwrap();
+        assert_eq!(ct, CT_APPLICATION_DATA);
+        let packet = decrypt_record(&peer.keys, false, peer.read_seq, ct, &encrypted).unwrap();
+        peer.read_seq += 1;
+        assert!(packet.len() >= 60);
+        assert_eq!(packet[0] >> 4, 6);
+        assert_eq!(packet.len(), 40 + u16::from_be_bytes([packet[4], packet[5]]) as usize,
+            "one complete inner IP packet per TLS record");
+        let tcp = TcpPacket::parse(&packet[40..]).unwrap();
+        if tcp.flags.syn {
+            initial_seq = tcp.sequence_number.wrapping_add(1);
+            respond(&mut peer, tcp.source_port, initial_seq, &mut sequence, true, &[]).await;
+            continue;
+        }
+        if tcp.payload.is_empty() { continue; }
+        largest = largest.max(packet.len());
+        let limit = if shrinks && received >= 512 * 1024 { 1400 } else { 8192 };
+        if packet.len() > limit { drops += 1; continue; }
+        let offset = tcp.sequence_number.wrapping_sub(initial_seq) as usize;
+        let skip = received.saturating_sub(offset).min(tcp.payload.len());
+        if skip < tcp.payload.len() { reordered.insert(offset + skip, tcp.payload[skip..].to_vec()); }
+        while let Some(bytes) = reordered.remove(&received) { received += bytes.len(); afc.extend_from_slice(&bytes); }
+        let ack = initial_seq.wrapping_add(received as u32);
+        let mut replied = false;
+        while afc.len() >= 48 {
+            let word = |at| u64::from_le_bytes(afc[at..at + 8].try_into().unwrap());
+            let entire = word(8) as usize;
+            assert!((48..=4 * 1024 * 1024 + 48).contains(&entire));
+            if afc.len() < entire { break; }
+            assert_eq!(word(16), 48);
+            assert_eq!(word(40), 7);
+            let opcode = word(32);
+            assert!([0x10, 0x14].contains(&opcode));
+            if opcode == 0x10 {
+                for (n, byte) in afc[48..entire].iter().enumerate() {
+                    assert_eq!(*byte, ((payload_offset + n) % 251) as u8);
+                }
+                payload_offset += entire - 48;
+            }
+            let mut status = Vec::new();
+            for value in [word(0), 48, 48, word(24), 1, 0] { status.extend_from_slice(&value.to_le_bytes()); }
+            afc.drain(..entire);
+            respond(&mut peer, tcp.source_port, ack, &mut sequence, false, &status).await;
+            replied = true;
+            if opcode == 0x14 {
+                completed.send((payload_offset, drops, largest)).unwrap();
+                // Keep the socket alive until the test explicitly stops it.
+                std::future::pending::<()>().await;
+                unreachable!();
+            }
+        }
+        if !replied { respond(&mut peer, tcp.source_port, ack, &mut sequence, false, &[]).await; }
+    }
+}
+
+#[tokio::test]
+async fn afc_payload_and_record_boundaries_survive_probing_and_path_shrink() {
+    for suite in [CipherSuite::Aes128CbcSha, CipherSuite::Aes256CbcSha384] {
+        for shrinks in [false, true] {
+            let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+            let client = TcpStream::connect(listener.local_addr().unwrap()).await.unwrap();
+            let (server, _) = listener.accept().await.unwrap();
+            client.set_nodelay(true).unwrap();
+            server.set_nodelay(true).unwrap();
+            let (completed, completion) = tokio::sync::oneshot::channel();
+            let worker = tokio::spawn(serve(keyed(server, suite), shrinks, completed));
+            let mut adapter = crate::tcp::adapter::Adapter::new(Box::new(keyed(client, suite)), HOST.into(), PEER.into());
+            adapter.enable_packet_size_probing(16000).unwrap();
+            let mut handle = adapter.to_async_handle();
+            let stream = handle.connect(1234).await.unwrap();
+            let mut client = crate::afc::AfcClient::new(crate::Idevice::new(Box::new(stream), "dynamic-tunnel-test"));
+            // On a deliberately failing test, suppress the descriptor's debug
+            // drop assertion so the original transfer failure stays readable.
+            let mut file = std::mem::ManuallyDrop::new(unsafe {
+                crate::afc::file::FileDescriptor::new(&mut client, 7, "fixture.ipa".into())
+            });
+            let payload: Vec<u8> = (0..4 * 1024 * 1024 + 123).map(|n| (n % 251) as u8).collect();
+            let outcome = tokio::time::timeout(Duration::from_secs(30), async {
+                file.write_entire(&payload).await.map_err(|e| e.to_string())?;
+                // SAFETY: take once after a successful write; ManuallyDrop
+                // itself never drops the moved value, including on timeout.
+                let owned = unsafe { std::mem::ManuallyDrop::take(&mut file) };
+                owned.close().await.map_err(|e| e.to_string())?;
+                completion.await.map_err(|e| e.to_string())
+            }).await;
+            worker.abort();
+            let worker_result = worker.await;
+            let _ = handle.close().await;
+            assert!(!worker_result.is_err_and(|e| e.is_panic()), "TLS/AFC peer failed");
+            let (bytes, drops, largest) = outcome.expect("dynamic TLS/AFC transfer stalled").expect("TLS/AFC transfer failed");
+            assert_eq!(bytes, payload.len());
+            assert!(drops > 0, "must exercise oversized probes and recovery");
+            assert!(largest > 8192, "the search is not hard-capped at 8 KiB");
+        }
+    }
+}
