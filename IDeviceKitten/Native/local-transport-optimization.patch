+// Reloading also rebuilds tracing's callsite cache, so disabled events never
+// evaluate their fields. Do not create a console worker for disabled startup.
+static LOGGING_SETTINGS_LOCK: Mutex<()> = Mutex::new(());
+static LOGGING_ENABLED: AtomicBool = AtomicBool::new(true);
+static LOGGING_FILTER: OnceLock<reload::Handle<LevelFilter, Registry>> = OnceLock::new();
+
+/// Updates Aether's native logging setting. Disabled startup installs no logger;
+/// enabling initializes it once, and later changes reload the global filter.
+#[unsafe(no_mangle)]
+pub extern "C" fn idevice_set_logging_enabled(enabled: bool) {
+    let _settings = LOGGING_SETTINGS_LOCK.lock().unwrap_or_else(|e| e.into_inner());
+    LOGGING_ENABLED.store(enabled, Ordering::SeqCst);
+    if enabled {
+        unsafe { idevice_init_logger(IdeviceLogLevel::Info, IdeviceLogLevel::Disabled, std::ptr::null_mut()); }
+    }
+    if let Some(filter) = LOGGING_FILTER.get() {
+        let level = if LOGGING_ENABLED.load(Ordering::SeqCst) { LevelFilter::TRACE } else { LevelFilter::OFF };
+        let _ = filter.reload(level);
     }
 }

