+#[cfg(test)]
+mod self_install_handoff_tests {
+    use super::*;
+    use std::sync::{Arc, atomic::{AtomicUsize, Ordering}};
+
+    #[tokio::test]
+    async fn command_sent_handoff_does_not_wait_for_progress_or_completion() {
+        // Small capacity forces the whole command to be consumed before the write completes.
+        let (client, peer) = tokio::io::duplex(32);
+        let (sent_tx, sent_rx) = tokio::sync::oneshot::channel();
+        let peer = tokio::spawn(async move {
+            let mut peer = Idevice::new(Box::new(peer), "test-peer");
+            let request = peer.read_plist().await.unwrap();
+            assert_eq!(request.get("Command").and_then(|x| x.as_string()), Some("Install"));
+            assert_eq!(request.get("PackagePath").and_then(|x| x.as_string()), Some("PublicStaging/Self.ipa"));
+            // No percentage or acknowledgement is sent until handoff has happened.
+            sent_rx.await.unwrap();
+            peer.send_plist(crate::plist!({"Status": "Complete"})).await.unwrap();
+        });
+        let progress = Arc::new(AtomicUsize::new(0));
+        let mut client = InstallationProxyClient::new(Idevice::new(Box::new(client), "test"));
+        tokio::time::timeout(std::time::Duration::from_secs(2),
+            client.install_with_callback_and_handoff("PublicStaging/Self.ipa", None,
+                |(_, count)| async move { count.fetch_add(1, Ordering::SeqCst); }, progress.clone(),
+                || async move { sent_tx.send(()).unwrap(); })
+        ).await.expect("handoff must not wait for a response").unwrap();
+        peer.await.unwrap();
+        assert_eq!(progress.load(Ordering::SeqCst), 0);
+    }
+
+    #[tokio::test]
+    async fn failed_transmission_does_not_handoff() {
+        let (client, peer) = tokio::io::duplex(32);
+        drop(peer);
+        let count = AtomicUsize::new(0);
+        let mut client = InstallationProxyClient::new(Idevice::new(Box::new(client), "test"));
+        assert!(client.install_with_callback_and_handoff("PublicStaging/Self.ipa", None,
+            |_| async {}, (), || async { count.fetch_add(1, Ordering::SeqCst); }).await.is_err());
+        assert_eq!(count.load(Ordering::SeqCst), 0);
+    }
+
+    #[tokio::test]
+    async fn command_sent_does_not_assert_service_success() {
+        let (client, peer) = tokio::io::duplex(4096);
+        let peer = tokio::spawn(async move {
+            let mut peer = Idevice::new(Box::new(peer), "test-peer");
+            peer.read_plist().await.unwrap();
+            peer.send_plist(crate::plist!({"ErrorDescription": "Rejected test package"})).await.unwrap();
+        });
+        let count = AtomicUsize::new(0);
+        let mut client = InstallationProxyClient::new(Idevice::new(Box::new(client), "test"));
+        let result = client.install_with_callback_and_handoff("PublicStaging/Self.ipa", None,
+            |_| async {}, (), || async { count.fetch_add(1, Ordering::SeqCst); }).await;
+        assert!(result.is_err(), "a flushed command can still be rejected");
+        assert_eq!(count.load(Ordering::SeqCst), 1);
+        peer.await.unwrap();
+    }
+}
