 use crate::{IdeviceError, ReadWrite, RemoteXpcClient, provider::RsdProvider};
 
+/// Bound connection establishment itself, so a cancelled Swift caller cannot
+/// leave a native handshake holding the shared RSD lock indefinitely. This does
+/// not impose a timeout on reads/writes after the service has been established.
+/// Two establishment steps fit within Aether's four-second attempt budget.
+pub async fn with_connection_timeout<T>(
+    operation: impl std::future::Future<Output = Result<T, IdeviceError>>,
+) -> Result<T, IdeviceError> {
+    tokio::time::timeout(std::time::Duration::from_secs(2), operation)
+        .await
+        .map_err(|_| IdeviceError::Timeout)?
+}
