+    #[tokio::test]
+    async fn progress_reports_inside_packet_and_waits_for_reply_before_completion() {
+        let (client, mut server) = tokio::io::duplex(64 * 1024);
+        let reports = std::sync::Arc::new(std::sync::Mutex::new(Vec::<u64>::new()));
+        let received = reports.clone();
+        let receiver = tokio::spawn(async move {
+            for expected in [MAX_WRITE_TRANSFER, 123] {
+                let (sequence, bytes) = receive_write(&mut server).await;
+                assert_eq!(bytes.len(), expected);
+                assert!(bytes.iter().all(|b| *b == 0x5a));
+                // The final payload byte must not be published before this acknowledgement.
+                {
+                let events = received.lock().unwrap();
+                assert!(!events.is_empty());
+                assert!(events.last().copied().unwrap() < ((sequence as usize) * MAX_WRITE_TRANSFER + expected) as u64);
+                if sequence == 0 { assert!(events.iter().any(|n| *n > 0 && *n < (MAX_WRITE_TRANSFER / 2) as u64)); }
+                }
+                reply(&mut server, sequence, 0).await;
+            }
+        });
+        let mut publish = |n| reports.lock().unwrap().push(n);
+        let mut file = file(client);
+        let mut metrics = crate::afc::AfcWriteDiagnostics::default();
+        file.as_mut().write_profiled_with_progress(&vec![0x5a; MAX_WRITE_TRANSFER + 123], &mut metrics, Some(&mut publish)).await.unwrap();
+        receiver.await.unwrap();
+        let events = reports.lock().unwrap();
+        assert_eq!(events.last().copied(), Some((MAX_WRITE_TRANSFER + 123) as u64));
+        assert!(events.windows(2).all(|p| p[1] >= p[0]));
+        assert_eq!(metrics.replies, 2);
+    }
+
