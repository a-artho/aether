+        let receiver = tokio::spawn(async move {
+            let (sequence, _) = receive_write(&mut server).await;
+            reply(&mut server, sequence, 18).await;
+            let mut next = [0u8; 1];
+            assert_eq!(server.read(&mut next).await.unwrap(), 0);
+        });
+        let mut reports = Vec::<u64>::new();
+        let mut publish = |n| reports.push(n);
+        let mut file = file(client);
+        let mut metrics = crate::afc::AfcWriteDiagnostics::default();
+        let result = file.as_mut().write_profiled_with_progress(&vec![0x5a; MAX_WRITE_TRANSFER + 123], &mut metrics, Some(&mut publish)).await;
+        assert!(matches!(result, Err(IdeviceError::Afc(_))));
+        drop(file); receiver.await.unwrap();
+        assert!(reports.iter().all(|n| *n < MAX_WRITE_TRANSFER as u64));
+        assert_eq!(metrics.replies, 0);
+    }
+
+}
