+// Authentication is the only TLV failure that proves an existing record invalid.
+fn saved_pairing_rejection(data: &[u8]) -> IdeviceError {
+    if data == [0x02] { // kTLVError_Authentication
+        RemotePairingError::PairVerifyFailed.into()
+    } else {
+        IdeviceError::UnexpectedResponse(format!("Pair verification could not complete: TLV error {data:?}"))
+    }
+}
+
+#[cfg(test)]
+mod saved_pairing_tests {
+    use super::*;
+
+    #[test]
+    fn only_authentication_invalidates_a_record() {
+        let error = saved_pairing_rejection(&[2]);
+        assert_eq!((error.code(), error.sub_code()), (103, 5));
+        for value in [1, 3, 4, 5, 6, 7, 0] {
+            let error = saved_pairing_rejection(&[value]);
+            assert_ne!((error.code(), error.sub_code()), (103, 5));
+        }
+        assert_ne!(saved_pairing_rejection(&[]).code(), 103);
+    }
+}
