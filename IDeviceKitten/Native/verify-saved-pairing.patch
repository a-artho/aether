+#[cfg(test)]
+mod verification_only_wire_tests {
+    use super::*;
+    use tokio::io::{AsyncReadExt, AsyncWriteExt, DuplexStream};
+
+    async fn read_frame(peer: &mut DuplexStream) -> Vec<u8> {
+        // Use the protocol's actual header length, without depending on its value.
+        let mut prefix = vec![0; RPPAIRING_MAGIC.len()];
+        peer.read_exact(&mut prefix).await.unwrap();
+        assert_eq!(prefix, RPPAIRING_MAGIC);
+        let mut len = [0; 2];
+        peer.read_exact(&mut len).await.unwrap();
+        let mut data = vec![0; u16::from_be_bytes(len) as usize];
+        peer.read_exact(&mut data).await.unwrap();
+        data
     }
+
+    async fn send_frame(peer: &mut DuplexStream, body: serde_json::Value) {
+        let body = serde_json::to_vec(&body).unwrap();
+        peer.write_all(RPPAIRING_MAGIC).await.unwrap();
+        peer.write_all(&(body.len() as u16).to_be_bytes()).await.unwrap();
+        peer.write_all(&body).await.unwrap();
+    }
+
+    #[tokio::test]
+    async fn explicit_rejection_survives_peer_close_without_pair_setup() {
+        let (stream, mut peer) = tokio::io::duplex(4096);
+        let server = tokio::spawn(async move {
+            let first = read_frame(&mut peer).await;
+            assert!(String::from_utf8(first).unwrap().contains("attemptPairVerify"));
+            send_frame(&mut peer, serde_json::json!({"message":{"plain":{"_0":{"response":{"_1":{"handshake":{"_0":{}}}}}}}})).await;
+            let second = read_frame(&mut peer).await;
+            assert!(String::from_utf8(second).unwrap().contains("verifyManualPairing"));
+            // ErrorResponse=authentication (2); close before the client's cleanup write.
+            send_frame(&mut peer, serde_json::json!({"message":{"plain":{"_0":{"event":{"_0":{"pairingData":{"_0":{"data":"BwEC"}}}}}}}})).await;
+        });
+        let mut client = RemotePairingClient::new(RpPairingSocket::new(stream), "AetherTest");
+        let mut record = RpPairingFile::generate("AetherTest");
+        let error = client.verify_saved_pairing(&mut record).await.unwrap_err();
+        server.await.unwrap();
+        assert_eq!((error.code(), error.sub_code()), (103, 5));
+    }
+
+    #[tokio::test]
+    async fn closed_transport_is_not_authentication_rejection() {
+        let (stream, mut peer) = tokio::io::duplex(4096);
+        let server = tokio::spawn(async move { let _ = read_frame(&mut peer).await; });
+        let mut client = RemotePairingClient::new(RpPairingSocket::new(stream), "AetherTest");
+        let mut record = RpPairingFile::generate("AetherTest");
+        let error = client.verify_saved_pairing(&mut record).await.unwrap_err();
+        server.await.unwrap();
+        assert_eq!(error.code(), 1);
+        assert_ne!((error.code(), error.sub_code()), (103, 5));
+    }
 }
