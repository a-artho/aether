+#[cfg(test)]
+mod tls_stream_tests {
+    use super::*;
+    use std::io;
+
+    #[derive(Default)]
+    struct Writer { wire: Vec<u8>, calls: usize, partial: usize, zero: bool, fail: bool, shutdown: bool }
+    impl AsyncRead for Writer {
+        fn poll_read(self: Pin<&mut Self>, _: &mut Context<'_>, _: &mut ReadBuf<'_>) -> Poll<io::Result<()>> { Poll::Pending }
+    }
+    impl AsyncWrite for Writer {
+        fn poll_write(mut self: Pin<&mut Self>, cx: &mut Context<'_>, data: &[u8]) -> Poll<io::Result<usize>> {
+            self.calls += 1;
+            if self.fail { return Poll::Ready(Err(io::ErrorKind::BrokenPipe.into())); }
+            if self.zero { return Poll::Ready(Ok(0)); }
+            if self.calls % 2 == 1 { cx.waker().wake_by_ref(); return Poll::Pending; }
+            let n = if self.partial == 0 { data.len() } else { data.len().min(self.partial) };
+            self.wire.extend_from_slice(&data[..n]);
+            Poll::Ready(Ok(n))
+        }
+        fn poll_flush(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<io::Result<()>> { Poll::Ready(Ok(())) }
+        fn poll_shutdown(mut self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<io::Result<()>> { self.shutdown = true; Poll::Ready(Ok(())) }
+    }
+    fn stream(suite: CipherSuite, writer: Writer) -> TlsPskStream<Writer> {
+        TlsPskStream { inner: writer, keys: KeyBlock::new(vec![1;suite.mac_key_len()], vec![1;suite.mac_key_len()], vec![2;suite.enc_key_len()], vec![2;suite.enc_key_len()], suite), write_seq: 0, read_seq: 0, read_buf: vec![], pending_record: vec![], pending_record_total: 0, write_buf: vec![], write_buf_offset: 0 }
+    }
+    fn decoded(stream: &TlsPskStream<Writer>) -> Vec<u8> {
+        let b = &stream.inner.wire;
+        let mut pos = 0;
+        let mut sequence = 0;
+        let mut output = vec![];
+        while pos < b.len() {
+            let length = u16::from_be_bytes([b[pos+3], b[pos+4]]) as usize;
+            output.extend(decrypt_record(&stream.keys, false, sequence, CT_APPLICATION_DATA, &b[pos+5..pos+5+length]).unwrap());
+            pos += 5 + length;
+            sequence += 1;
+        }
+        assert_eq!(sequence, stream.write_seq);
+        output
+    }
+    #[tokio::test]
+    async fn pending_writes_do_not_duplicate_plaintext() {
+        for suite in [CipherSuite::Aes128CbcSha, CipherSuite::Aes256CbcSha384] {
+            let mut s = stream(suite, Writer::default());
+            s.write_all(b"one payload").await.unwrap();
+            s.flush().await.unwrap();
+            assert_eq!(decoded(&s), b"one payload");
+        }
+    }
+    #[tokio::test]
+    async fn partial_pending_multirecord_writes_preserve_data_and_sequences() {
+        let payload: Vec<u8> = (0..40000).map(|n| (n % 251) as u8).collect();
+        for suite in [CipherSuite::Aes128CbcSha, CipherSuite::Aes256CbcSha384] {
+            let mut s = stream(suite, Writer { partial: 113, ..Writer::default() });
+            s.write_all(&payload).await.unwrap();
+            s.flush().await.unwrap();
+            assert_eq!(decoded(&s), payload);
+            assert_eq!(s.write_seq, 3);
+            assert!(s.write_buf.capacity() <= 32768);
+        }
+    }
+    #[tokio::test]
+    async fn shutdown_flushes_the_last_accepted_record() {
+        let mut s = stream(CipherSuite::Aes256CbcSha384, Writer::default());
+        s.write_all(b"last record").await.unwrap();
+        s.shutdown().await.unwrap();
+        assert!(s.inner.shutdown);
+        assert_eq!(decoded(&s), b"last record");
+    }
+    #[tokio::test]
+    async fn zero_writes_and_transport_errors_are_propagated() {
+        for (writer, expected) in [(Writer { zero: true, ..Writer::default() }, io::ErrorKind::WriteZero), (Writer { fail: true, ..Writer::default() }, io::ErrorKind::BrokenPipe)] {
+            let mut s = stream(CipherSuite::Aes256CbcSha384, writer);
+            s.write_all(b"buffered").await.unwrap();
+            assert_eq!(s.flush().await.unwrap_err().kind(), expected);
+        }
+    }
+    #[tokio::test]
+    async fn empty_writes_do_not_emit_records() {
