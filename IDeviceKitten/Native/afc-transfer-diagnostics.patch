+    /// Diagnostic equivalent of write: identical packet order, sizes and reply checks.
+    pub async fn write_profiled(mut self: Pin<&mut Self>, bytes: &[u8], metrics: &mut crate::afc::AfcWriteDiagnostics) -> Result<(), IdeviceError> {
+        for chunk in bytes.chunks(MAX_WRITE_TRANSFER) {
+            let start = std::time::Instant::now();
+            let header_payload = self.as_ref().fd.to_le_bytes().to_vec();
+            let payload = chunk.to_vec();
+            metrics.copy_seconds += start.elapsed().as_secs_f64();
+            // SAFETY: the pinned fields are not moved, matching send_packet.
+            let this = unsafe { self.as_mut().get_unchecked_mut() };
+            let header_len = header_payload.len() as u64 + AfcPacketHeader::LEN;
+            let packet = AfcPacket {
+                header: AfcPacketHeader { magic: MAGIC, entire_len: header_len + payload.len() as u64,
+                    header_payload_len: header_len, packet_num: this.client.package_number, operation: AfcOpcode::Write },
+                header_payload, payload,
+            };
+            this.client.package_number += 1;
+            let start = std::time::Instant::now();
+            let wire = packet.serialize();
+            metrics.serialize_seconds += start.elapsed().as_secs_f64();
+            metrics.packets += 1;
+            this.client.idevice.send_raw_profiled(&wire, metrics).await?;
+            let start = std::time::Instant::now();
+            let result = this.client.read().await;
+            metrics.reply_seconds += start.elapsed().as_secs_f64();
+            result?;
+            metrics.replies += 1;
         }
         Ok(())
     }
