+    #[cfg(feature = "afc")]
+    pub(crate) async fn send_raw_profiled(&mut self, message: &[u8], metrics: &mut crate::afc::AfcWriteDiagnostics) -> Result<(), IdeviceError> {
+        let socket = self.socket.as_mut().ok_or(IdeviceError::NoEstablishedConnection)?;
+        let start = std::time::Instant::now();
+        let result: Result<(), std::io::Error> = async {
+            // Preserve send_raw_with_progress's 64 KiB subdivisions and write_all semantics.
+            for part in message.chunks(64 * 1024) {
+                let mut remaining = part;
+                while !remaining.is_empty() {
+                    let n = std::future::poll_fn(|cx| {
+                        let poll_start = std::time::Instant::now();
+                        let result = std::pin::Pin::new(&mut **socket).poll_write(cx, remaining);
+                        let elapsed = poll_start.elapsed().as_secs_f64();
+                        metrics.poll_seconds += elapsed;
+                        metrics.max_poll_seconds = metrics.max_poll_seconds.max(elapsed);
+                        metrics.write_polls += 1;
+                        if result.is_pending() { metrics.pending_polls += 1; }
+                        result
+                    }).await?;
+                    if n == 0 { return Err(std::io::ErrorKind::WriteZero.into()); }
+                    metrics.socket_bytes += n as u64;
+                    remaining = &remaining[n..];
+                }
+            }
+            Ok(())
+        }.await;
+        metrics.socket_write_seconds += start.elapsed().as_secs_f64();
+        result?;
+        let start = std::time::Instant::now();
+        let result = std::future::poll_fn(|cx| {
+            metrics.flush_polls += 1;
+            let result = std::pin::Pin::new(&mut **socket).poll_flush(cx);
+            if result.is_pending() { metrics.flush_pending_polls += 1; }
+            result
+        }).await;
+        metrics.flush_seconds += start.elapsed().as_secs_f64();
+        result?;
+        Ok(())
     }
 
