+/// Diagnostic variant of afc_file_write. Output is reset on entry, including errors.
+/// Caller must provide valid handle/data pointers and a writable output struct.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn afc_file_write_diagnostics(
+    handle: *mut AfcFileHandle, data: *const u8, length: libc::size_t,
+    output: *mut AfcWriteDiagnostics,
+) -> *mut IdeviceFfiError {
+    if output.is_null() { return ffi_err!(IdeviceError::FfiInvalidArg); }
+    unsafe { *output = Default::default(); }
+    if handle.is_null() || data.is_null() { return ffi_err!(IdeviceError::FfiInvalidArg); }
+    let fd = unsafe { &mut *(handle as *mut idevice::afc::file::FileDescriptor) };
+    let data_slice = unsafe { std::slice::from_raw_parts(data, length) };
+    let submitted = std::time::Instant::now();
+    let (res, mut metrics, finished) = run_sync(async move {
+        let worker_started = std::time::Instant::now();
+        let mut metrics = idevice::afc::AfcWriteDiagnostics::default();
+        metrics.queue_seconds = submitted.elapsed().as_secs_f64();
+        let res = fd.write_entire_profiled(data_slice, &mut metrics).await;
+        metrics.worker_seconds = worker_started.elapsed().as_secs_f64();
+        (res, metrics, std::time::Instant::now())
+    });
+    metrics.return_seconds = finished.elapsed().as_secs_f64();
+    unsafe { *output = AfcWriteDiagnostics { queue_seconds: metrics.queue_seconds, worker_seconds: metrics.worker_seconds, return_seconds: metrics.return_seconds, copy_seconds: metrics.copy_seconds, serialize_seconds: metrics.serialize_seconds, socket_write_seconds: metrics.socket_write_seconds, flush_seconds: metrics.flush_seconds, reply_seconds: metrics.reply_seconds, poll_seconds: metrics.poll_seconds, max_poll_seconds: metrics.max_poll_seconds, packets: metrics.packets, replies: metrics.replies, socket_bytes: metrics.socket_bytes, write_polls: metrics.write_polls, pending_polls: metrics.pending_polls, flush_polls: metrics.flush_polls, flush_pending_polls: metrics.flush_pending_polls }; }
+    match res { Ok(_) => null_mut(), Err(e) => ffi_err!(e) }
+}
