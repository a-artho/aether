+/// Read the peer MSS from a SYN option list. Ignore malformed/zero MSS values.
+pub(crate) fn parse_mss(options: &[u8]) -> Option<usize> {
+    let mut offset = 0;
+    while offset < options.len() {
+        match options[offset] {
+            0 => break,
+            1 => offset += 1,
+            kind => {
+                let len = *options.get(offset + 1)? as usize;
+                if len < 2 || offset + len > options.len() { return None; }
+                if kind == 2 && len == 4 {
+                    let mss = u16::from_be_bytes([options[offset + 2], options[offset + 3]]) as usize;
+                    return (mss > 0).then_some(mss);
+                }
+                offset += len;
+            }
+        }
+    }
+    None
