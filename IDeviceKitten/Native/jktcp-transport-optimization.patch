+    // Aether transport regressions: exercise cancellation at the actual
+    // AsyncWrite boundary, including TLS-style acceptance before flush.
+    #[derive(Debug, Default)]
+    struct Capture {
+        wire: Vec<u8>, calls: usize, flushes: usize, max_write: usize,
+        block_after: Option<usize>, block_flush: bool, zero: bool, fail: bool,
+    }
+    #[derive(Debug, Clone)]
+    struct CaptureTransport(std::sync::Arc<std::sync::Mutex<Capture>>);
+    impl AsyncRead for CaptureTransport {
+        fn poll_read(self: Pin<&mut Self>, _: &mut Context<'_>, _: &mut ReadBuf<'_>) -> Poll<std::io::Result<()>> { Poll::Pending }
+    }
+    impl AsyncWrite for CaptureTransport {
+        fn poll_write(self: Pin<&mut Self>, _: &mut Context<'_>, bytes: &[u8]) -> Poll<std::io::Result<usize>> {
+            let mut c = self.0.lock().unwrap();
+            c.calls += 1;
+            if c.fail { return Poll::Ready(Err(ErrorKind::BrokenPipe.into())); }
+            if c.zero { return Poll::Ready(Ok(0)); }
+            if c.block_after.is_some_and(|n| c.wire.len() >= n) { return Poll::Pending; }
+            let n = bytes.len().min(if c.max_write == 0 { usize::MAX } else { c.max_write });
+            c.wire.extend_from_slice(&bytes[..n]);
+            Poll::Ready(Ok(n))
+        }
+        fn poll_flush(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<std::io::Result<()>> {
+            let mut c = self.0.lock().unwrap(); c.flushes += 1;
+            if c.block_flush { Poll::Pending } else { Poll::Ready(Ok(())) }
+        }
+        fn poll_shutdown(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<std::io::Result<()>> { self.poll_flush(cx) }
+    }
+    fn captured_adapter(batch: usize) -> (Adapter, std::sync::Arc<std::sync::Mutex<Capture>>) {
+        let capture = std::sync::Arc::new(std::sync::Mutex::new(Capture::default()));
+        let mut adapter = Adapter::new(Box::new(CaptureTransport(capture.clone())), HOST_IP.into(), PEER_IP.into());
+        adapter.set_mss(1220).set_write_batch_size(batch);
