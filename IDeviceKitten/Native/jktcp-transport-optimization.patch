+    #[tokio::test(start_paused = true)]
+    async fn aether_mtu_probe_loss_and_path_changes_preserve_complete_payload() {
+        for (initial_limit, later_limit) in [(8192, 8192), (1400, 1400), (16000, 16000), (16000, 1400)] {
+            let (mut adapter, capture) = probing_adapter(16000);
+            adapter.set_send_window(65536);
+            let payload: Vec<u8> = (0..2 * 1024 * 1024).map(|n| (n % 251) as u8).collect();
+            let initial_seq = adapter.states[&1234].seq;
+            adapter.queue_send(&payload, 1234).unwrap();
+            let mut received = Vec::new();
+            let mut reordered = std::collections::BTreeMap::<usize, Vec<u8>>::new();
+            let mut drops = 0;
+            let mut largest = 0;
+            for step in 0..10000 {
+                adapter.write_buffer_flush().await.unwrap();
+                let packets = take_packets(&capture);
+                if packets.is_empty() { tokio::time::advance(Duration::from_millis(201)).await; }
+                for packet in packets {
+                    if packet.payload.is_empty() { continue; }
+                    largest = largest.max(packet.payload.len() + 60);
+                    let limit = if received.len() >= 512 * 1024 { later_limit } else { initial_limit };
+                    if packet.payload.len() + 60 > limit { drops += 1; continue; }
+                    let offset = packet.sequence_number.wrapping_sub(initial_seq) as usize;
+                    let skip = received.len().saturating_sub(offset).min(packet.payload.len());
+                    if skip < packet.payload.len() {
+                        reordered.insert(offset + skip, packet.payload[skip..].to_vec());
+                    }
+                    while let Some(bytes) = reordered.remove(&received.len()) { received.extend_from_slice(&bytes); }
+                    let ack = initial_seq.wrapping_add(received.len() as u32);
+                    ack_sent(&mut adapter, ack).await;
+                }
+                assert!(!matches!(adapter.states[&1234].status, ConnectionStatus::Error(_)), "path {initial_limit}->{later_limit}, step {step}");
+                if received.len() == payload.len() { break; }
+            }
+            assert_eq!(received, payload, "path {initial_limit}->{later_limit}");
+            assert_eq!(adapter.states[&1234].bytes_in_flight, 0);
+            if initial_limit == 16000 { assert!(largest > 8192, "must search above 8 KiB"); }
+            if later_limit < 16000 { assert!(drops > 0, "must exercise loss and repair"); }
+            assert!(adapter.states[&1234].path_mtu.as_ref().unwrap().mss() + 60 <= later_limit);
+        }
+    }
