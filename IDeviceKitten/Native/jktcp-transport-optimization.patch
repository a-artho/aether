+    fn captured_packets(capture: &std::sync::Arc<std::sync::Mutex<Capture>>) -> Vec<TcpPacket> {
+        let c = capture.lock().unwrap(); let mut wire = &c.wire[..]; let mut packets = vec![];
+        while !wire.is_empty() {
+            match Ipv6Packet::parse(wire, &None) {
+                IpParseError::Ok { packet, bytes_consumed } => {
