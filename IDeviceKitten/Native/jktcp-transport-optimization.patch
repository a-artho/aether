+// SPDX-License-Identifier: GPL-3.0-or-later
+// Adapted from PyTCP / pmd-pytcp's PmtuSearch and TcpPlpmtudAdapter.
+// Copyright (C) 2020-present Sebastian Majewski and pmd-pytcp contributors.
+// Reference: doronz88/pmd-pytcp@80628207dde459b305a262f98596328e405f32bd
+// lib/plpmtud.py and protocols/tcp/tcp__plpmtud_adapter.py.
+// Aether's Rust adaptation retains the probing-mode search, three-ACK
+// validation, retransmission invalidation and RTO black-hole demotion rules.
+
+use crate::time::Instant;
+use std::time::Duration;
+
+const VALIDATION_ACKS: u8 = 3;
+const MAX_PROBES: u8 = 3;
+const GRANULARITY: usize = 8;
+const PROBE_TIMER: Duration = Duration::from_millis(1500);
+const RAISE_TIMER: Duration = Duration::from_secs(600);
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Phase { Base, Searching, Complete, Error }
+
+#[derive(Clone, Copy, Debug)]
+struct Range { start: u32, end: u32, size: usize }
+
+#[derive(Clone, Debug)]
+pub(crate) struct PathMtu {
+    phase: Phase,
+    overhead: usize,
+    seed: usize,
+    current: usize,
+    low: usize,
+    high: usize,
+    maximum: usize,
+    base: usize,
+    candidate: Option<usize>,
+    validation: u8,
+    losses: u8,
+    deadline: Option<Instant>,
+    raise_at: Option<Instant>,
+    probe: Option<Range>,
+    implicit: Option<Range>,
+}
+
+impl PathMtu {
+    /// `maximum` is bounded by the negotiated MTU AND the peer's MSS.
+    /// A very small peer MSS also bounds the seed; it must never be exceeded.
+    pub(crate) fn new(maximum: usize, overhead: usize) -> Self {
+        let minimum = if overhead == 60 { 1280 } else { 576 };
+        let base = if overhead == 60 { 1280 } else { 1200 }.min(maximum);
+        let seed = 1400.min(maximum);
+        Self {
+            phase: Phase::Base, overhead, seed, current: seed,
+            low: minimum.min(maximum), high: maximum, maximum, base,
+            candidate: Some(base), validation: 0, losses: 0,
+            deadline: None, raise_at: None, probe: None, implicit: None,
+        }
+    }
+
+    pub(crate) fn mss(&self) -> usize { self.current - self.overhead }
+
+    pub(crate) fn probe_deadline(&self) -> Option<Instant> { self.deadline }
+
+    fn next_candidate(&self) -> Option<usize> {
+        if self.high.saturating_sub(self.low) <= GRANULARITY { return None; }
+        let mut mid = ((self.low + self.high) / 2 / GRANULARITY) * GRANULARITY;
+        if mid <= self.low { mid = self.low + GRANULARITY; }
+        (mid < self.high).then_some(mid)
+    }
+
+    fn search(&mut self, now: Instant) {
+        self.candidate = self.next_candidate();
+        self.deadline = None;
+        if self.candidate.is_some() { self.phase = Phase::Searching; }
+        else {
+            self.phase = Phase::Complete;
+            self.raise_at = Some(now + RAISE_TIMER);
+        }
+    }
+
+    fn probe_loss(&mut self, now: Instant) {
+        if !matches!(self.phase, Phase::Base | Phase::Searching) { return; }
+        self.losses += 1;
+        self.deadline = None;
+        self.validation = 0;
+        if self.losses >= MAX_PROBES {
+            self.phase = Phase::Error;
+            self.current = self.seed;
+            self.candidate = None;
+            self.losses = 0;
+            self.raise_at = Some(now + RAISE_TIMER);
+        } else if self.phase == Phase::Searching {
+            if let Some(candidate) = self.candidate { self.high = candidate - 1; }
+            self.search(now);
+        }
+    }
+
+    /// Called by the maintenance path too, so a short final write cannot
+    /// strand an expired probe waiting for another application write.
+    pub(crate) fn poll(&mut self, now: Instant) {
+        if self.probe.is_some() && self.deadline.is_some_and(|at| now >= at) {
+            self.probe = None;
+            self.probe_loss(now);
+        }
+        if self.raise_at.is_some_and(|at| now >= at) {
+            self.raise_at = None;
+            match self.phase {
+                Phase::Complete => { self.high = self.maximum; self.search(now); }
+                Phase::Error => {
+                    self.phase = Phase::Base;
+                    self.candidate = Some(self.base);
+                    self.losses = 0;
+                }
+                _ => {}
+            }
+        }
+    }
+
+    /// Query only; arm the deadline when a feasible packet is actually queued.
+    pub(crate) fn candidate_mss(&self) -> Option<usize> {
+        if self.probe.is_some() || self.phase != Phase::Searching { return None; }
+        self.candidate.filter(|size| *size > self.current).map(|size| size - self.overhead)
+    }
+
+    pub(crate) fn sent(&mut self, start: u32, length: usize, is_probe: bool, now: Instant) {
+        let range = Range { start, end: start.wrapping_add(length as u32), size: length + self.overhead };
+        if is_probe {
+            debug_assert!(self.probe.is_none());
+            debug_assert_eq!(self.candidate, Some(range.size));
+            self.probe = Some(range);
+            self.deadline = Some(now + PROBE_TIMER);
+        } else if self.implicit.is_none_or(|old| range.size > old.size) {
+            self.implicit = Some(range);
+        }
+    }
+
+    /// The caller first validates that ACK is in the live sent sequence range.
+    pub(crate) fn acknowledged(&mut self, ack: u32, now: Instant) {
+        if self.probe.is_some_and(|p| seq_le(p.end, ack)) {
+            let probe = self.probe.take().unwrap();
+            self.losses = 0;
+            self.validation += 1;
+            self.deadline = None;
+            if self.validation >= VALIDATION_ACKS {
+                self.validation = 0;
+                self.low = self.low.max(probe.size);
+                self.current = self.current.max(probe.size);
+                self.search(now);
+            }
+        }
+        if self.implicit.is_some_and(|p| seq_le(p.end, ack)) {
+            let size = self.implicit.take().unwrap().size;
+            // A late ACK after demotion must not restore the revoked size.
+            if size <= self.current { self.low = self.low.max(size); }
+            if self.phase == Phase::Base && size >= self.base {
+                self.losses = 0;
+                self.search(now);
+            }
+        }
+    }
+
+    /// Invalidate BEFORE repair: a cumulative ACK of smaller repaired pieces
+    /// cannot prove delivery of the original large packet. Unrelated repairs
+    /// leave the probe alone, as in upstream's overlap-specific adapter hook.
+    pub(crate) fn retransmitting(&mut self, start: u32, end: u32, now: Instant) {
+        if self.implicit.is_some_and(|p| overlaps(start, end, p.start, p.end)) { self.implicit = None; }
+        if self.probe.is_some_and(|p| overlaps(start, end, p.start, p.end)) {
+            self.probe = None;
+            self.probe_loss(now);
+        }
+    }
+
+    pub(crate) fn timed_out(&mut self, now: Instant) {
+        self.implicit = None;
+        if self.probe.take().is_some() { self.probe_loss(now); }
+        // A size that passed isolated probes may fail under sustained load.
+        // Revoke it on RTO BEFORE choosing the retransmission segment sizes.
+        if self.current > self.seed {
+            let revoked = self.current;
+            self.current = self.seed;
+            self.low = self.low.min(self.seed);
+            self.high = self.high.min(revoked - 1);
+            self.losses = 0;
+            self.validation = 0;
+            self.deadline = None;
+            self.search(now);
+        }
+    }
+}
+
+fn seq_le(a: u32, b: u32) -> bool { b.wrapping_sub(a) as i32 >= 0 }
+fn seq_lt(a: u32, b: u32) -> bool { b.wrapping_sub(a) as i32 > 0 }
+fn overlaps(a: u32, b: u32, c: u32, d: u32) -> bool { seq_lt(a, d) && seq_lt(c, b) }
