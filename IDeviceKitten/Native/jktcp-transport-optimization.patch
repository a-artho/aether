+#[cfg(test)]
+mod aether_packet_tests {
+    use super::*;
+    fn checksum(bytes: &[u8]) -> u16 {
+        let mut sum = 0u32;
+        for word in bytes.chunks(2) {
+            sum += (u32::from(word[0]) << 8) | u32::from(*word.get(1).unwrap_or(&0));
+        }
+        while sum > 0xffff { sum = (sum & 0xffff) + (sum >> 16); }
+        !(sum as u16)
+    }
+    #[test]
+    fn append_matches_separate_ip_framing_and_independent_checksums() {
+        for (src, dst) in [("192.0.2.1", "192.0.2.2"), ("fd00::1", "fd00::2")] {
+            let src: IpAddr = src.parse().unwrap(); let dst: IpAddr = dst.parse().unwrap();
+            for size in [0, 1, 2, 1219, 1220, 15940] {
+                for options in [&[][..], &[3, 3, 8][..], &[2, 4, 4, 196][..]] {
+                    let payload: Vec<u8> = (0..size).map(|n| (n % 251) as u8).collect();
+                    let flags = TcpFlags { psh: true, ack: true, ..Default::default() };
+                    let tcp = TcpPacket::create(src, dst, 1234, 80, 0xfffffff0, 42, flags, 65534, options, &payload);
+                    let expected = match (src, dst) {
+                        (IpAddr::V4(s), IpAddr::V4(d)) => Ipv4Packet::create(s, d, ProtocolNumber::Tcp, 255, &tcp),
+                        (IpAddr::V6(s), IpAddr::V6(d)) => Ipv6Packet::create(s, d, ProtocolNumber::Tcp, 255, &tcp),
+                        _ => unreachable!(),
+                    };
+                    let mut out = vec![0xaa; 17];
+                    TcpPacket::append_ip(&mut out, src, dst, 1234, 80, 0xfffffff0, 42, flags, 65534, options, &payload);
+                    assert_eq!(&out[..17], &[0xaa; 17]);
+                    assert_eq!(&out[17..], expected);
+                    let mut pseudo = vec![];
+                    match (src, dst) {
+                        (IpAddr::V4(s), IpAddr::V4(d)) => {
+                            assert_eq!(checksum(&out[17..37]), 0);
+                            pseudo.extend_from_slice(&s.octets()); pseudo.extend_from_slice(&d.octets());
+                            pseudo.extend_from_slice(&[0, 6]); pseudo.extend_from_slice(&(tcp.len() as u16).to_be_bytes());
+                        }
+                        (IpAddr::V6(s), IpAddr::V6(d)) => {
+                            pseudo.extend_from_slice(&s.octets()); pseudo.extend_from_slice(&d.octets());
+                            pseudo.extend_from_slice(&(tcp.len() as u32).to_be_bytes()); pseudo.extend_from_slice(&[0, 0, 0, 6]);
+                        }
+                        _ => unreachable!(),
+                    }
+                    pseudo.extend_from_slice(&tcp);
+                    assert_eq!(checksum(&pseudo), 0, "invalid TCP checksum");
+                }
+            }
+        }
+    }
